<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mubsir.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mubsir.Core\Mubsir.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Mubsir.Overlay\motion-tokens.json" Link="data\motion-tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\books\*.pdf" Link="data\books\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\hudhud\rig.json" Link="data\rig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
