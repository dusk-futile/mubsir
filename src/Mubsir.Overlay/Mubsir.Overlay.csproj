<Project Sdk="Microsoft.NET.Sdk">

  <!-- The notch at the top of the screen, which shows anyone watching what Mubsir is doing.
       Plain WPF built in code (no XAML), on its own UI thread, so the host keeps its Win32 message loop. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>Mubsir.Overlay</RootNamespace>
    <AssemblyName>Mubsir.Overlay</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mubsir.Core\Mubsir.Core.csproj" />
  </ItemGroup>

  <!-- The tokens ship inside the assembly; the zip needs no extra files. -->
  <ItemGroup>
    <EmbeddedResource Include="motion-tokens.json" LogicalName="Mubsir.Overlay.motion-tokens.json" />
  </ItemGroup>

</Project>
